---
const {
  title = "Hunny Bunny English",
  description = "",
  lang = "ru"
} = Astro.props;

const baseUrl = "https://hunny-bunny-website.pages.dev";

const canonical =
  lang === "ru"
    ? `${baseUrl}/`
    : `${baseUrl}/${lang}/`;

const keywords =
  lang === "ru"
    ? "курсы английского языка, английский для детей, английский онлайн, школа английского языка, Hunny Bunny English"
    : lang === "en"
    ? "english courses, english for children, online english school, english lessons, Hunny Bunny English"
    : "kurs angielskiego, angielski dla dzieci, szkoła języka angielskiego, lekcje angielskiego, Hunny Bunny English";
---
<!doctype html>
<html lang={lang}>
	<head>
	<meta charset="UTF-8" />

  <meta http-equiv="content-language" content={lang} />

	<meta name="viewport" content="width=device-width" />

	<link rel="icon" href="/favicon.ico" />

	<meta name="generator" content={Astro.generator} />

	<meta name="google-site-verification" content="KBQM2LkBUru2yETmVTMCcrXY2AAPoZCd3it4kSc3rOU" />
	
	<title>{title}</title>

	<meta
  name="description"
  content={description}
/>

	<meta
  name="keywords"
  content={keywords}
/>

	<meta name="robots" content="index, follow" />

  <link rel="canonical" href={canonical} />
  
  <link
  rel="alternate"
  hreflang="ru"
  href="https://hunny-bunny-website.pages.dev/"
/>

<link
  rel="alternate"
  hreflang="en"
  href="https://hunny-bunny-website.pages.dev/en/"
/>

<link
  rel="alternate"
  hreflang="pl"
  href="https://hunny-bunny-website.pages.dev/pl/"
/>

<link
  rel="alternate"
  hreflang="x-default"
  href="https://hunny-bunny-website.pages.dev/"
/>

<meta property="og:title" content={title} />

<meta property="og:description" content={description} />

<meta
	property="og:image"
	content="https://hunny-bunny-website.pages.dev/images/logo.PNG"
/>

<meta property="og:type" content="website" />

<meta
  property="og:locale"
  content={
    lang === "ru"
      ? "ru_RU"
      : lang === "en"
      ? "en_US"
      : "pl_PL"
  }
/>

<meta property="og:url" content={canonical} />

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "Hunny Bunny English",
  "url": "https://hunny-bunny-website.pages.dev/",
  "logo": "https://hunny-bunny-website.pages.dev/images/logo.PNG",
  "image": "https://hunny-bunny-website.pages.dev/images/logo.PNG",
  "description": "Онлайн и офлайн курсы английского языка для детей, подростков и взрослых.",

  "telephone": "+48 451 090 218",
  "email": "mailto:julichka1988@yandex.by",

  "address": {
    "@type": "PostalAddress",
    "streetAddress": "ул. Крестьянская, 33",
    "addressLocality": "Гомель",
    "addressRegion": "Гомельская область",
    "postalCode": "246000",
    "addressCountry": "BY"
  },

  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 52.4345,
    "longitude": 30.9754
  },

  "areaServed": [
    {
      "@type": "City",
      "name": "Гомель"
    },
    {
      "@type": "Country",
      "name": "Беларусь"
    },
    {
      "@type": "Place",
      "name": "Онлайн по всему миру"
    }
  ],

  "sameAs": [
    "https://www.instagram.com/hunny_bunny_english",
    "https://www.youtube.com/@hunnybunnyenglish",
    "https://t.me/+8e7QThwn7-1kMmFi"
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Есть ли пробный урок?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Да, первое занятие проводится бесплатно. Длительность пробного занятия 20 минут."
      }
    },
    {
      "@type": "Question",
      "name": "Можно заниматься онлайн?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Да, занятия проходят онлайн для учеников из любой точки мира."
      }
    },
    {
      "@type": "Question",
      "name": "Сколько человек в группе?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "В группе от 4 до 8 учеников для максимального внимания каждому."
      }
    },
    {
      "@type": "Question",
      "name": "Где проходят занятия?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Онлайн — из любой точки мира. Офлайн — в Республике Беларусь, город Гомель."
      }
    },
    {
      "@type": "Question",
      "name": "Какой уровень английского нужен для начала?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Мы подбираем программу для любого уровня — от Beginner до Advanced."
      }
    },
    {
      "@type": "Question",
      "name": "Есть ли занятия для взрослых?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Да, мы обучаем детей, подростков и взрослых любого уровня."
      }
    }
  ]
}
</script>

</head>
	<body>

<div
  class="language-switcher"
  style="
    position:fixed;
    top:20px;
    right:20px;
    z-index:10000;
    display:flex;
    gap:6px;
    background:rgba(255,255,255,0.95);
    padding:8px 14px;
    border-radius:30px;
    box-shadow:0 4px 12px rgba(0,0,0,.12);
    font-family:Arial,sans-serif;
    font-weight:bold;
    backdrop-filter:blur(8px);
  "
>
  <a
  href="/"
  style={`
    text-decoration:none;
    font-weight:bold;
    padding:6px 12px;
    border-radius:20px;
    transition:0.3s;
    background:${lang === 'ru' ? '#8b5cf6' : 'transparent'};
    color:${lang === 'ru' ? 'white' : '#555'};
  `}
>
  RU
</a>

<a
  href="/en"
  style={`
    text-decoration:none;
    font-weight:bold;
    padding:6px 12px;
    border-radius:20px;
    transition:0.3s;
    background:${lang === 'en' ? '#8b5cf6' : 'transparent'};
    color:${lang === 'en' ? 'white' : '#555'};
  `}
>
  EN
</a>

<a
  href="/pl"
  style={`
    text-decoration:none;
    font-weight:bold;
    padding:6px 12px;
    border-radius:20px;
    transition:0.3s;
    background:${lang === 'pl' ? '#8b5cf6' : 'transparent'};
    color:${lang === 'pl' ? 'white' : '#555'};
  `}
>
  PL
</a>
</div>

<slot />

</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
  .language-switcher{
    transition:.3s;
}

@media (max-width:768px){

.language-switcher{

    top:12px;
    right:12px;

    padding:6px 10px;

    gap:3px;

    font-size:13px;

}

}
</style>
