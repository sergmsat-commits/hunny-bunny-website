---
import '@fontsource-variable/manrope';
import '@fontsource-variable/unbounded';
import '../styles/global.css';
import { business, homePath, langs, type Lang } from '../data/business';
import CookieBanner from '../components/CookieBanner.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  noindex?: boolean;
  faq?: { q: string; a: string }[];
  ogLocale?: string;
  path?: string; // адрес страницы, если это не главная, например '/privacy/'
  alternates?: Partial<Record<Lang, string>>; // адреса этой же страницы на других языках
  schema?: object[]; // дополнительная разметка schema.org (курс, хлебные крошки)
}

const { title, description = '', lang = 'ru', noindex = false, faq = [], ogLocale = 'ru_RU', path, alternates, schema = [] } = Astro.props;
const site = business.site;
const canonical = `${site}${path ?? homePath[lang]}`;
const alt: Partial<Record<Lang, string>> = alternates ?? homePath;
const ogImage = `${site}/og/og-${lang}.jpg`;

const g = business.gomel;
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['EducationalOrganization', 'LocalBusiness'],
  '@id': `${site}/#school`,
  name: business.name,
  url: `${site}/`,
  logo: `${site}/images/logo.PNG`,
  image: `${site}/images/logo.PNG`,
  description:
    lang === 'ru'
      ? 'Школа английского языка для детей от 3 лет, подростков и взрослых: Гомель, Варшава и онлайн.'
      : lang === 'pl'
        ? 'Szkoła angielskiego dla dzieci od 3 lat, młodzieży i dorosłych: Warszawa, Homel i online.'
        : 'English school for children from age 3, teenagers and adults: Gomel, Warsaw and online.',
  telephone: business.phones.by.e164,
  email: business.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: g.street.ru,
    addressLocality: g.city.ru,
    addressRegion: 'Гомельская область',
    postalCode: g.postalCode,
    addressCountry: g.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: g.geo.lat, longitude: g.geo.lng },
  openingHours: g.openingHours,
  areaServed: ['Гомель', 'Warszawa', 'Online'],
  founder: { '@type': 'Person', name: lang === 'ru' ? 'Юлия Сатырова' : 'Yuliya Satyrava' },
  sameAs: [business.socials.instagram, business.socials.youtube, business.messengers.telegram],
};
const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage: lang,
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }
  : null;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  {!noindex && <link rel="canonical" href={canonical} />}
  {!noindex && langs.filter((l) => alt[l]).map((l) => <link rel="alternate" hreflang={l} href={`${site}${alt[l]}`} />)}
  {!noindex && alt.ru && <link rel="alternate" hreflang="x-default" href={`${site}${alt.ru}`} />}

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#F7F5FF" />
  <meta name="google-site-verification" content="KBQM2LkBUru2yETmVTMCcrXY2AAPoZCd3it4kSc3rOU" />
  <meta name="yandex-verification" content="4684ccf34f425f11" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Hunny Bunny English" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Hunny Bunny English" />
  <meta property="og:locale" content={ogLocale} />
  <meta name="twitter:card" content="summary_large_image" />

  {!noindex && !path && <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

  <!-- Google Analytics и Яндекс Метрика загружаются только после согласия в баннере cookies -->
  <script is:inline>
    (function () {
      var v = null;
      try { v = localStorage.getItem('hb-consent'); } catch (e) {}
      window.hbLoadGA = function () {
        if (window.__hbGA) return;
        window.__hbGA = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-1ZBMP7LNPQ';
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', 'G-1ZBMP7LNPQ');
      };
      // Яндекс Метрика (счётчик 113689907) — тоже только после согласия
      window.hbLoadYM = function () {
        if (window.__hbYM) return;
        window.__hbYM = true;
        (function (m, e, t, r, i, k, a) {
          m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
          m[i].l = 1 * new Date();
          k = e.createElement(t); a = e.getElementsByTagName(t)[0];
          k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
        })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js?id=113689907', 'ym');
        window.ym(113689907, 'init', { webvisor: true, clickmap: true, accurateTrackBounce: true, trackLinks: true });
      };
      document.documentElement.dataset.consent = v || 'unset';
      if (v === 'granted') { window.hbLoadGA(); window.hbLoadYM(); }
    })();
  </script>
</head>
<body>
  <slot />
  <CookieBanner lang={lang} />
  <Lightbox lang={lang} />
</body>
</html>
