---
import '@fontsource-variable/manrope';
import '@fontsource-variable/unbounded';
import '../styles/global.css';
import { business, homePath, langs, type Lang } from '../data/business';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  noindex?: boolean;
  faq?: { q: string; a: string }[];
  ogLocale?: string;
}

const { title, description = '', lang = 'ru', noindex = false, faq = [], ogLocale = 'ru_RU' } = Astro.props;
const site = business.site;
const canonical = `${site}${homePath[lang]}`;
const ogImage = `${site}/images/logo.PNG`;

const g = business.gomel;
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': ['EducationalOrganization', 'LocalBusiness'],
  '@id': `${site}/#school`,
  name: business.name,
  url: `${site}/`,
  logo: `${site}/images/logo.PNG`,
  image: `${site}/images/logo.PNG`,
  description:
    lang === 'ru'
      ? 'Школа английского языка для детей от 3 лет, подростков и взрослых: Гомель, Варшава и онлайн.'
      : lang === 'pl'
        ? 'Szkoła angielskiego dla dzieci od 3 lat, młodzieży i dorosłych: Warszawa, Homel i online.'
        : 'English school for children from age 3, teenagers and adults: Gomel, Warsaw and online.',
  telephone: business.phones.by.e164,
  address: {
    '@type': 'PostalAddress',
    streetAddress: g.street.ru,
    addressLocality: g.city.ru,
    addressRegion: 'Гомельская область',
    postalCode: g.postalCode,
    addressCountry: g.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: g.geo.lat, longitude: g.geo.lng },
  openingHours: g.openingHours,
  areaServed: ['Гомель', 'Warszawa', 'Online'],
  founder: { '@type': 'Person', name: lang === 'ru' ? 'Юлия Сатырова' : 'Yuliya Satyrava' },
  sameAs: [business.socials.instagram, business.socials.youtube, business.messengers.telegram],
};
const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage: lang,
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }
  : null;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  {!noindex && <link rel="canonical" href={canonical} />}
  {!noindex && langs.map((l) => <link rel="alternate" hreflang={l} href={`${site}${homePath[l]}`} />)}
  {!noindex && <link rel="alternate" hreflang="x-default" href={`${site}/`} />}

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#F7F5FF" />
  <meta name="google-site-verification" content="KBQM2LkBUru2yETmVTMCcrXY2AAPoZCd3it4kSc3rOU" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Hunny Bunny English" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={ogLocale} />

  {!noindex && <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-1ZBMP7LNPQ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-1ZBMP7LNPQ');
  </script>
</head>
<body>
  <slot />
</body>
</html>
