---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Courses from './Courses.astro';
import Why from './Why.astro';
import Team from './Team.astro';
import Gallery from './Gallery.astro';
import Reviews from './Reviews.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import StickyBar from './StickyBar.astro';
import { translations } from '../i18n/translations';
import type { Lang } from '../data/business';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = translations[lang];
---
<Layout lang={lang} title={t.seo.title} description={t.seo.description} faq={t.faq.items} ogLocale={t.locale}>
  <a href="#main" class="skip-link">{t.a11y.skip}</a>
  <Header t={t} lang={lang} />
  <main id="main">
    <Hero t={t} lang={lang} />
    <Courses t={t} />
    <Why t={t} />
    <Team t={t} />
    <Gallery t={t} />
    <Reviews t={t} lang={lang} />
    <Faq t={t} />
    <Contact t={t} lang={lang} />
  </main>
  <Footer t={t} lang={lang} />
  <StickyBar t={t} lang={lang} />
</Layout>
