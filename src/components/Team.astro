---
import { Picture } from 'astro:assets';
import satyrova from '../assets/team/satyrova.jpg';
import laevskaya from '../assets/team/laevskaya.jpg';
import barinova from '../assets/team/barinova.jpg';
import rud from '../assets/team/rud.jpg';
import Icon from './Icon.astro';
import type { Translation } from '../i18n/translations';

interface Props {
  t: Translation;
}
const { t } = Astro.props;
const photos: Record<string, ImageMetadata> = { satyrova, laevskaya, barinova, rud };
---
<section id="team" class="section">
  <div class="container">
    <div class="section-head">
      <h2>{t.team.title}</h2>
      <p>{t.team.lead}</p>
    </div>
    <ul class="team-grid" role="list">
      {t.team.people.map((p) => (
        <li class="card person">
          <Picture src={photos[p.photo]} alt={p.name} widths={[280, 420, 560]} sizes="(min-width: 1140px) 280px, (min-width: 720px) 45vw, 90vw" formats={['avif', 'webp']} class="person-photo" />
          <div class="person-body">
            <p class="person-role">{p.role}</p>
            <h3>{p.name}</h3>
            {p.note && <p class="person-note">{p.note}</p>}
          </div>
        </li>
      ))}
    </ul>
    <div class="card skills">
      <h3 class="skills-title">{t.team.skillsTitle}</h3>
      <ul class="skills-list" role="list">
        {t.team.skills.map((s) => (
          <li><Icon name="check" size={16} stroke={2.4} />{s}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .team-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .person {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .person :global(.person-photo) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
  }
  .person-body {
    padding: 14px 14px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .person h3 {
    font-size: 16px;
  }
  .person-role {
    font-size: 13px;
    font-weight: 700;
    color: var(--c-primary-ink);
  }
  .person-note {
    font-size: 14px;
    line-height: 1.45;
    color: var(--c-muted);
  }
  .skills {
    margin-top: 16px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .skills-title {
    font-size: 17px;
  }
  .skills-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .skills-list li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--c-lavender);
    font-size: 15px;
    font-weight: 600;
    color: var(--c-ink);
  }
  .skills-list :global(svg) {
    color: var(--c-primary);
  }
  @media (min-width: 960px) {
    .skills {
      margin-top: 20px;
      padding: 24px 28px;
      flex-direction: row;
      align-items: center;
      gap: 24px;
    }
    .skills-title {
      flex: none;
      max-width: 200px;
    }
  }
  @media (min-width: 1140px) {
    .team-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
    }
    .person-body {
      padding: 18px 20px 22px;
    }
    .person h3 {
      font-size: 19px;
    }
    .person-note {
      font-size: 15px;
    }
  }
</style>
