---
import { Picture } from 'astro:assets';
import a from '../assets/lessons/lesson-teacher-kids.jpg';
import b from '../assets/lessons/lesson-group-table.jpg';
import c from '../assets/lessons/lesson-class.jpg';
import d from '../assets/lessons/lesson-desk.jpg';
import Zoomable from './Zoomable.astro';
import type { Translation } from '../i18n/translations';

interface Props {
  t: Translation;
}
const { t } = Astro.props;
const photos = [a, b, c, d];
---
<section class="section gallery" aria-labelledby="gallery-title">
  <div class="container">
    <div class="section-head reveal">
      <h2 id="gallery-title">{t.gallery.title}</h2>
    </div>
    <ul class="gallery-grid" role="list">
      {photos.map((src, i) => (
        <li class="zoom-frame reveal">
          <Zoomable src={src} alt={t.gallery.alts[i]} label={t.a11y.openPhoto}>
            <Picture src={src} alt={t.gallery.alts[i]} widths={[300, 450, 600]} sizes="(min-width: 960px) 280px, 45vw" formats={['avif', 'webp']} />
          </Zoomable>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .gallery {
    background: var(--c-surface);
  }
  .gallery-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .gallery-grid li {
    border-radius: var(--r-l);
    overflow: hidden;
    background: var(--c-lavender);
    aspect-ratio: 3 / 4;
  }
  .gallery-grid :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 960px) {
    .gallery-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
    }
  }
</style>
