---
// «Почему мы» в виде мозаики: фото класса, крупные цифры и тёмная карточка с 3D-зайчиком.
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Bunny from './Bunny.astro';
import Deco from './Deco.astro';
import Zoomable from './Zoomable.astro';
import classPhoto from '../assets/lessons/lesson-class.jpg';
import type { Translation } from '../i18n/translations';

interface Props {
  t: Translation;
}
const { t } = Astro.props;
const [groups, practice, place, trial] = t.why.items as { big?: string; icon: string; title: string; text: string }[];
---
<section class="section why">
  <div class="container">
    <div class="section-head reveal">
      <h2>{t.why.title}</h2>
    </div>
    <ul class="bento" role="list">
      <li class="tile tile-photo zoom-frame reveal">
        <Zoomable src={classPhoto} alt={place.text} label={t.a11y.openPhoto}>
          <Picture src={classPhoto} alt={place.text} widths={[400, 600, 900]} sizes="(min-width: 960px) 560px, 92vw" formats={['avif', 'webp']} />
        </Zoomable>
        <div class="tile-photo-caption">
          <span class="icon-chip"><Icon name={place.icon} size={18} stroke={2} /></span>
          <div>
            <h3>{place.title}</h3>
            <p>{place.text}</p>
          </div>
        </div>
      </li>
      {[groups, practice].map((w) => (
        <li class="tile tile-stat reveal">
          <p class="tile-big">{w.big}</p>
          <h3>{w.title}</h3>
          <p class="tile-text">{w.text}</p>
        </li>
      ))}
      <li class="tile tile-dark reveal">
        <Deco name="sparkle" size={18} class="d-s1" />
        <Deco name="sparkle" size={12} class="d-s2" />
        <div class="tile-dark-text">
          <p class="tile-big">{trial.big}</p>
          <h3>{trial.title}</h3>
          <p class="tile-text">{trial.text}</p>
        </div>
        <Bunny height={150} class="why-bunny" delay={2.5} />
      </li>
    </ul>
  </div>
</section>

<style>
  .why {
    background: var(--c-surface);
  }
  .bento {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .tile {
    position: relative;
    border-radius: var(--r-l);
    overflow: hidden;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .tile h3 {
    font-size: 16px;
    line-height: 1.25;
  }
  .tile-big {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 34px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--c-primary);
    margin-bottom: 6px;
  }
  .tile-text {
    font-size: 14px;
    line-height: 1.5;
    color: var(--c-ink-2);
  }
  .tile-stat {
    background: linear-gradient(160deg, #f4f1ff 0%, #ece8ff 100%);
    box-shadow: inset 0 0 0 1px var(--c-lavender);
  }
  .tile-stat:nth-child(3) .tile-big {
    color: var(--c-heart);
  }

  .tile-photo {
    grid-column: 1 / -1;
    padding: 0;
    min-height: 320px;
    background: var(--c-lavender);
  }
  .tile-photo :global(.zoom) {
    position: absolute;
    inset: 0;
  }
  .tile-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile-photo-caption {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 2;
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px 16px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(10px) saturate(1.4);
    -webkit-backdrop-filter: blur(10px) saturate(1.4);
    pointer-events: none;
  }
  .tile-photo-caption p {
    font-size: 14px;
    line-height: 1.45;
    color: var(--c-ink-2);
  }
  .icon-chip {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--c-lavender);
    color: var(--c-primary);
  }

  .tile-dark {
    grid-column: 1 / -1;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
    padding: 22px 20px 0;
    color: #fff;
    background:
      radial-gradient(60% 90% at 90% 100%, rgba(224, 95, 216, 0.45), transparent 70%),
      radial-gradient(50% 80% at 0% 0%, rgba(91, 79, 217, 0.7), transparent 70%),
      var(--c-ink);
  }
  .tile-dark-text {
    padding-bottom: 22px;
    max-width: 420px;
  }
  .tile-dark .tile-big {
    color: #f6c24b;
  }
  .tile-dark .tile-text {
    color: #d9d5ff;
  }
  .tile-dark :global(.why-bunny) {
    flex: none;
    margin-right: -6px;
  }
  .tile-dark :global(.d-s1) {
    top: 18px;
    right: 120px;
  }
  .tile-dark :global(.d-s2) {
    top: 46px;
    right: 26px;
  }

  /* Узкий телефон: цифра слева, текст справа, чтобы длинные слова не обрезались */
  @media (max-width: 599px) {
    .tile-stat {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 14px;
      row-gap: 4px;
      align-items: start;
    }
    .tile-stat .tile-big {
      grid-row: 1 / span 2;
      font-size: 28px;
      margin: 2px 0 0;
      min-width: 76px;
    }
  }
  @media (min-width: 960px) {
    .bento {
      grid-template-columns: 1.25fr 1fr 1fr;
      grid-template-rows: auto auto;
      gap: 20px;
    }
    .tile {
      padding: 28px;
    }
    .tile h3 {
      font-size: 19px;
    }
    .tile-big {
      font-size: 52px;
    }
    .tile-text {
      font-size: 15.5px;
    }
    .tile-photo {
      grid-column: 1;
      grid-row: 1 / span 2;
      min-height: 520px;
      padding: 0;
    }
    .tile-photo-caption {
      left: 16px;
      right: 16px;
      bottom: 16px;
    }
    .tile-dark {
      grid-column: 2 / span 2;
      padding: 28px 28px 0;
    }
    .tile-dark-text {
      padding-bottom: 28px;
    }
  }
</style>
