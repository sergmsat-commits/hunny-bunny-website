---
// Статья блога: заголовок, текст, совет, карточка курса, другие статьи, форма.
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import StickyBar from './StickyBar.astro';
import Contact from './Contact.astro';
import Icon from './Icon.astro';
import Deco from './Deco.astro';
import Bunny from './Bunny.astro';
import { translations } from '../i18n/translations';
import { business, homePath, type Lang } from '../data/business';
import { blogPath, blogUi, postIds, postMeta, postPath, posts, type PostId } from '../data/blog';
import { coursePath, courses } from '../data/courses';

interface Props {
  lang: Lang;
  id: PostId;
}
const { lang, id } = Astro.props;
const t = translations[lang];
const ui = blogUi[lang];
const post = posts[id][lang]!;
const meta = postMeta[id];
const path = postPath[id][lang]!;
const site = business.site;
const course = courses[meta.course][lang];
const others = postIds.filter((x) => x !== id && posts[x][lang]);
const date = new Date(meta.date).toLocaleDateString({ ru: 'ru-RU', en: 'en-GB', pl: 'pl-PL' }[lang], { day: 'numeric', month: 'long', year: 'numeric' });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.home, item: `${site}${homePath[lang]}` },
      { '@type': 'ListItem', position: 2, name: ui.title, item: `${site}${blogPath[lang]}` },
      { '@type': 'ListItem', position: 3, name: post.title, item: `${site}${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.description,
    inLanguage: lang,
    datePublished: meta.date,
    dateModified: meta.date,
    mainEntityOfPage: `${site}${path}`,
    image: `${site}/og/og-${lang}.jpg`,
    author: { '@type': 'Organization', name: business.name, url: `${site}/` },
    publisher: { '@type': 'EducationalOrganization', '@id': `${site}/#school`, name: business.name, logo: `${site}/images/logo.PNG` },
  },
];
---
<Layout lang={lang} title={post.seoTitle} description={post.description} ogLocale={t.locale} path={path} alternates={postPath[id]} schema={schema}>
  <a href="#main" class="skip-link">{t.a11y.skip}</a>
  <Header t={t} lang={lang} />
  <main id="main">
    <article class="post">
      <header class="post-hero">
        <Deco name="flower" size={56} tone={meta.tone} class="p-fl" />
        <Deco name="sparkle" size={18} class="p-sp" />
        <div class="container narrow">
          <nav class="crumbs" aria-label="breadcrumbs">
            <a href={homePath[lang]}>{ui.home}</a>
            <span aria-hidden="true">/</span>
            <a href={blogPath[lang]}>{ui.title}</a>
          </nav>
          <h1>{post.title}</h1>
          <p class="post-meta">
            <time datetime={meta.date}>{date}</time>
            <span aria-hidden="true">·</span>
            <span>{post.readTime}</span>
          </p>
          <p class="post-lead">{post.lead}</p>
        </div>
      </header>

      <div class="container narrow post-body">
        {post.body.map((b) => (
          <section>
            {b.h && <h2>{b.h}</h2>}
            {b.list && <ul>{b.list.map((li) => <li>{li}</li>)}</ul>}
            {b.p && b.p.map((x) => <p>{x}</p>)}
            {b.tip && (
              <aside class="tip">
                <span class="tip-icon" aria-hidden="true"><Icon name="heart" size={18} filled stroke={1.5} /></span>
                <p>{b.tip}</p>
              </aside>
            )}
          </section>
        ))}

        <aside class="post-cta">
          <div class="post-cta-text">
            <p class="post-cta-title">{ui.trial}</p>
            <p>{ui.trialText}</p>
            <div class="post-cta-actions">
              <a href="#contact" class="btn btn-primary">{t.cta.trial}</a>
              <a href={coursePath[meta.course][lang]} class="btn btn-secondary">{ui.courseCta}: {course.short}</a>
            </div>
          </div>
          <Bunny height={130} class="post-bunny" delay={1} />
        </aside>
      </div>
    </article>

    {others.length > 0 && (
      <section class="section post-more">
        <div class="container narrow">
          <h2>{ui.more}</h2>
          <ul class="more-list" role="list">
            {others.map((o) => (
              <li>
                <a href={postPath[o][lang]} class="more-item">
                  <span class="more-emoji" aria-hidden="true">{postMeta[o].emoji}</span>
                  <span>{posts[o][lang]!.title}</span>
                  <Icon name="arrow" size={18} stroke={2.2} />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <Contact t={t} lang={lang} who={meta.course === 'teens' ? 1 : meta.course === 'adults' ? 2 : 0} />
  </main>
  <Footer t={t} lang={lang} />
  <StickyBar t={t} lang={lang} contactHref="#contact" />
</Layout>

<style>
  .narrow {
    max-width: calc(780px + 2 * var(--gutter));
  }
  .post-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: 20px 28px;
  }
  .post-hero::before {
    content: '';
    position: absolute;
    inset: -80px 0 0;
    z-index: -1;
    background:
      radial-gradient(45% 70% at 92% 30%, rgba(243, 182, 234, 0.45), transparent 70%),
      radial-gradient(40% 70% at 4% 10%, rgba(207, 201, 255, 0.6), transparent 70%);
  }
  .post-hero :global(.p-fl) {
    top: 24px;
    right: 6%;
  }
  .post-hero :global(.p-sp) {
    top: 96px;
    right: 15%;
  }
  .crumbs {
    display: flex;
    gap: 6px;
    font-size: 14px;
    margin-bottom: 14px;
  }
  .crumbs a {
    color: var(--c-primary-ink);
    font-weight: 600;
    text-decoration: none;
  }
  .post h1 {
    font-size: clamp(30px, 5.4vw, 46px);
  }
  .post-meta {
    display: flex;
    gap: 8px;
    margin-top: 14px;
    font-size: 14px;
    color: var(--c-muted);
  }
  .post-lead {
    margin-top: 16px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--c-ink-2);
  }
  .post-body {
    padding-bottom: 32px;
  }
  .post-body section {
    margin-top: 32px;
  }
  .post-body h2 {
    font-size: clamp(22px, 3vw, 28px);
    margin-bottom: 12px;
  }
  .post-body p {
    font-size: 17.5px;
    line-height: 1.7;
    color: var(--c-ink-2);
  }
  .post-body p + p {
    margin-top: 12px;
  }
  .post-body ul {
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .post-body ul li {
    position: relative;
    padding-left: 28px;
    font-size: 17.5px;
    line-height: 1.6;
    color: var(--c-ink-2);
  }
  .post-body ul li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.62em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--c-primary), var(--c-heart));
  }
  .tip {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-top: 20px;
    padding: 18px 20px;
    border-radius: var(--r-l);
    background: linear-gradient(160deg, #fff3fc, #f1edff);
    box-shadow: inset 0 0 0 1px var(--c-lavender);
  }
  .tip p {
    color: var(--c-ink);
    font-weight: 600;
    font-size: 16.5px;
  }
  .tip-icon {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--c-surface);
    color: var(--c-heart);
  }
  .post-cta {
    position: relative;
    margin-top: 44px;
    display: flex;
    align-items: flex-end;
    gap: 12px;
    padding: 24px 20px 0 24px;
    border-radius: var(--r-xl);
    color: #fff;
    overflow: hidden;
    background:
      radial-gradient(60% 90% at 100% 100%, rgba(224, 95, 216, 0.45), transparent 70%),
      radial-gradient(60% 80% at 0% 0%, rgba(91, 79, 217, 0.7), transparent 70%),
      var(--c-ink);
  }
  .post-cta-text {
    padding-bottom: 24px;
  }
  .post-cta p {
    color: #d9d5ff;
  }
  .post-cta .post-cta-title {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 24px;
    color: #fff;
    margin-bottom: 8px;
  }
  .post-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
  }
  .post-cta .btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);
  }
  .post-cta :global(.post-bunny) {
    flex: none;
  }
  .post-more {
    padding-top: 0;
  }
  .post-more h2 {
    font-size: 24px;
    margin-bottom: 16px;
  }
  .more-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .more-item {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 64px;
    padding: 10px 18px;
    border-radius: var(--r-m);
    background: var(--c-surface);
    box-shadow: inset 0 0 0 1px var(--c-lavender);
    color: var(--c-ink);
    font-weight: 700;
    text-decoration: none;
  }
  .more-item span:nth-child(2) {
    flex: 1;
  }
  .more-item :global(svg) {
    color: var(--c-primary);
  }
  .more-item:hover {
    box-shadow: inset 0 0 0 2px var(--c-primary);
    color: var(--c-ink);
  }
  .more-emoji {
    font-size: 24px;
  }
  @media (max-width: 599px) {
    .post-hero :global(.p-fl),
    .post-hero :global(.p-sp) {
      display: none;
    }
    .post-cta :global(.post-bunny) {
      display: none !important;
    }
    .post-cta {
      padding-right: 24px;
    }
  }
  @media (min-width: 960px) {
    .post-hero {
      padding-block: 44px 36px;
    }
  }
</style>
