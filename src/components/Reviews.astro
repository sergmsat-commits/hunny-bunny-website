---
// Отзывы родителей: сообщения «как в мессенджере» плывут бегущей строкой.
// Текст — дословно из присланных сообщений; по кнопке открывается скриншот оригинала.
import Icon from './Icon.astro';
import type { Lang } from '../data/business';
import type { Translation } from '../i18n/translations';

interface Props {
  t: Translation;
  lang: Lang;
}
const { t } = Astro.props;
const r = t.reviews;
type Msg = { file?: string; tag?: string; paragraphs: string[] };
const all = r.items as Msg[];
// Скриншоты-оригиналы (первые три) перемешиваем с остальными сообщениями
const originals = all.filter((m) => m.file);
const rest = all.filter((m) => !m.file);
const parents: Msg[] = [];
rest.forEach((m, i) => {
  if (i % 3 === 0 && originals.length) parents.push(originals.shift()!);
  parents.push(m);
});
parents.push(...originals);
// Копии ленты нужны для бесшовной прокрутки; копий столько, чтобы лента была шире любого экрана.
// Сами копии скрыты от скринридеров и клавиатуры.
const copiesFor = (n: number) => (n >= 8 ? 2 : 4);
const rows = [
  { kind: 'parents', items: parents, copies: copiesFor(parents.length), speed: parents.length * 16 },
  { kind: 'kids', items: (r.kids as string[]).map((k) => ({ paragraphs: [`«${k}»`] }) as Msg), copies: copiesFor(r.kids.length), speed: r.kids.length * 14 },
];
---
<section id="reviews" class="section reviews">
  <div class="container">
    <div class="section-head reveal">
      <h2>{r.title}</h2>
      <p>{r.lead}</p>
    </div>
  </div>

  {rows.map((row) => (
    <Fragment>
    {row.kind === 'kids' && <p class="marquee-label container">{r.kidsTitle}</p>}
    <div class:list={['marquee', `marquee-${row.kind}`]} data-marquee style={`--copies:${row.copies}; --speed:${row.speed}s`}>
      <div class="marquee-track">
        {Array.from({ length: row.copies }, (_, c) => (
          <ul class="marquee-list" role="list" aria-hidden={c > 0 ? 'true' : undefined}>
            {row.items.map((item, i) => (
              <li class={`msg msg-${i % 3} msg-${row.kind}`}>
                <div class="msg-head">
                  <span class="msg-avatar" aria-hidden="true">
                    <Icon name={row.kind === 'kids' ? 'star' : 'heart'} size={16} filled stroke={1.5} />
                  </span>
                  <span class="msg-from">
                    {row.kind === 'kids' ? r.kid : r.from}
                    {item.tag && <span class="msg-tag">{item.tag}</span>}
                  </span>
                </div>
                <div class="msg-bubble">
                  {item.paragraphs.map((p) => <p>{p}</p>)}
                  {row.kind === 'parents' && <span class="msg-ticks" aria-hidden="true"><Icon name="check-double" size={16} stroke={2} /></span>}
                </div>
                {item.file && (
                  <a
                    href={`/images/reviews/ru/${item.file}.webp`}
                    class="msg-original"
                    data-lightbox
                    data-group="reviews"
                    data-alt={r.alt}
                    tabindex={c > 0 ? -1 : undefined}
                  >
                    <Icon name="expand" size={15} stroke={2} />{r.original}
                  </a>
                )}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
    </Fragment>
  ))}
</section>

<script>
  // На телефоне лента останавливается, пока палец лежит на ней
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((m) => {
    m.addEventListener('touchstart', () => m.classList.add('is-paused'), { passive: true });
    m.addEventListener('touchend', () => setTimeout(() => m.classList.remove('is-paused'), 1500), { passive: true });
  });
</script>

<style>
  .reviews {
    overflow: hidden;
  }
  .marquee {
    --gap: 16px;
    --speed: 60s;
    position: relative;
    padding-block: 8px 24px;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee var(--speed) linear infinite;
  }
  .marquee-kids .marquee-track {
    animation-direction: reverse;
  }
  .marquee-label {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 18px;
    margin-bottom: 8px;
  }
  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee.is-paused .marquee-track {
    animation-play-state: paused;
  }
  .marquee-list {
    list-style: none;
    margin: 0;
    padding: 0 var(--gap) 0 0;
    display: flex;
    align-items: flex-start;
    gap: var(--gap);
  }
  @keyframes marquee {
    to {
      transform: translateX(calc(-100% / var(--copies)));
    }
  }

  .msg {
    width: min(82vw, 340px);
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    animation: bob 6s ease-in-out infinite;
  }
  .msg-1 {
    margin-top: 28px;
    animation-delay: -2s;
  }
  .msg-2 {
    margin-top: 10px;
    animation-delay: -4s;
  }
  @keyframes bob {
    50% {
      transform: translateY(-6px);
    }
  }
  .msg-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-left: 4px;
  }
  .msg-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f3c4f0, var(--c-lavender-2));
    color: var(--c-heart);
  }
  .msg-from {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--c-muted);
  }
  .msg-tag {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--c-lavender);
    color: var(--c-primary-ink);
    font-size: 12px;
  }
  .msg-kids {
    width: min(70vw, 280px);
  }
  .msg-kids .msg-avatar {
    background: linear-gradient(135deg, #ffe2b8, #f6c24b);
    color: #fff;
  }
  .msg-kids .msg-bubble {
    border-radius: 22px 22px 6px 22px;
    background: linear-gradient(160deg, #fff7fd, #f5efff);
    font-weight: 600;
    padding-bottom: 16px;
  }
  .msg-bubble {
    position: relative;
    background: var(--c-surface);
    border-radius: 22px 22px 22px 6px;
    padding: 16px 18px 26px;
    box-shadow:
      0 1px 0 var(--c-lavender),
      0 18px 40px -16px rgba(35, 30, 69, 0.22);
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--c-ink);
  }
  .msg-bubble p + p {
    margin-top: 8px;
  }
  .msg-1 .msg-bubble {
    background: linear-gradient(180deg, #fff, #fbfaff);
  }
  .msg-ticks {
    position: absolute;
    right: 14px;
    bottom: 8px;
    color: var(--c-primary);
    opacity: 0.7;
  }
  .msg-original {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 12px;
    margin-left: 4px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--c-primary-ink);
    text-decoration: none;
    cursor: zoom-in;
    transition: background 0.2s;
  }
  .msg-original:hover {
    background: var(--c-lavender);
  }

  @media (min-width: 960px) {
    .marquee {
      --gap: 24px;
      --speed: 75s;
      padding-block: 16px 32px;
    }
    .msg {
      width: 380px;
    }
    .msg-bubble {
      font-size: 16px;
      padding: 20px 22px 30px;
    }
  }

  /* Без анимации: обычная лента с прокруткой пальцем */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-mask-image: none;
      mask-image: none;
      padding-inline: var(--gutter);
    }
    .marquee-list[aria-hidden='true'] {
      display: none;
    }
    .msg {
      scroll-snap-align: start;
    }
  }
</style>
