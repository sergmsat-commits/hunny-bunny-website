---
import Icon from './Icon.astro';
import type { Translation } from '../i18n/translations';
import type { Lang } from '../data/business';
import { coursePath, courseUi, courses, type CourseId } from '../data/courses';

interface Props {
  t: Translation;
  lang: Lang;
}
const { t, lang } = Astro.props;
// Карточки на главной идут в этом порядке; онлайн — отдельной ссылкой под ними
const ids: CourseId[] = ['kids', 'teens', 'adults', 'clubs'];
const more = courseUi[lang].more;
---
<section id="courses" class="section">
  <div class="container">
    <div class="section-head reveal">
      <h2>{t.courses.title}</h2>
      <p>{t.courses.lead}</p>
    </div>
    <ul class="courses-grid" role="list" data-carousel>
      {t.courses.items.map((c, i) => (
        <li class="card course">
          <span class="icon-tile"><Icon name={c.icon} size={26} /></span>
          <h3>{c.title}</h3>
          <p class="course-text">{c.text}</p>
          <ul class="course-points" role="list">
            {c.points.map((p) => (
              <li><Icon name="check" size={18} stroke={2.2} />{p}</li>
            ))}
          </ul>
          <a href={coursePath[ids[i]][lang]} class="course-more">
            {more}<span class="visually-hidden">: {c.title}</span><Icon name="arrow" size={18} stroke={2.2} />
          </a>
        </li>
      ))}
    </ul>
    <p class="online-link">
      <a href={coursePath.online[lang]}><Icon name="globe" size={20} stroke={2} />{courses.online[lang].h1}<Icon name="arrow" size={18} stroke={2.2} /></a>
    </p>
    <div class="carousel-dots" aria-hidden="true">
      {t.courses.items.map((_, i) => <span class:list={[{ active: i === 0 }]} />)}
    </div>
  </div>
</section>

<script>
  // Точки под лентой курсов на телефоне показывают, какая карточка сейчас на экране
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((list) => {
    const dots = list.parentElement?.querySelectorAll<HTMLElement>('.carousel-dots span');
    if (!dots?.length) return;
    const cards = Array.from(list.children) as HTMLElement[];
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const i = cards.indexOf(e.target as HTMLElement);
            dots.forEach((d, j) => d.classList.toggle('active', j === i));
          }
        });
      },
      { root: list, threshold: 0.6 },
    );
    cards.forEach((c) => io.observe(c));
  });
</script>

<style>
  /* Телефон: курсы — горизонтальная лента с «подглядывающей» следующей карточкой */
  .courses-grid {
    list-style: none;
    margin: 0 calc(-1 * var(--gutter));
    padding: 4px var(--gutter) 16px;
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .courses-grid::-webkit-scrollbar {
    display: none;
  }
  .courses-grid > li {
    flex: 0 0 84%;
    scroll-snap-align: start;
  }
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 4px;
  }
  .carousel-dots span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--c-lavender-2);
    transition: width 0.3s, background 0.3s;
  }
  .carousel-dots span.active {
    width: 24px;
    background: var(--c-primary);
  }
  .course {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .course-text {
    color: var(--c-ink-2);
    font-size: 16px;
  }
  .course-points {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .course-points li {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.45;
  }
  .course-more {
    margin-top: auto;
    padding-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--c-primary-ink);
    text-decoration: none;
  }
  .course-more:hover {
    color: var(--c-ink);
  }
  .course-more :global(svg) {
    transition: transform 0.2s;
  }
  .course-more:hover :global(svg) {
    transform: translateX(3px);
  }
  .online-link {
    margin-top: 16px;
  }
  .online-link a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--c-surface);
    box-shadow: inset 0 0 0 1px var(--c-lavender-2);
    font-weight: 700;
    color: var(--c-ink);
    text-decoration: none;
  }
  .online-link a :global(svg) {
    color: var(--c-primary);
  }
  .online-link a:hover {
    box-shadow: inset 0 0 0 2px var(--c-primary);
  }
  .course-points :global(svg) {
    color: var(--c-primary);
    flex: none;
    margin-top: 2px;
  }
  @media (min-width: 720px) {
    .courses-grid {
      margin: 0;
      padding: 0;
      overflow: visible;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
    .carousel-dots {
      display: none;
    }
  }
  @media (hover: hover) {
    .course {
      transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s;
    }
    .course:hover {
      transform: translateY(-4px);
      box-shadow: 0 1px 0 var(--c-lavender), 0 24px 48px -16px rgba(35, 30, 69, 0.25);
    }
  }
  @media (min-width: 1140px) {
    .courses-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
