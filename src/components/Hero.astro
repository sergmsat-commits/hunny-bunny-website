---
import { Image, Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Bunny from './Bunny.astro';
import Zoomable from './Zoomable.astro';
import Deco from './Deco.astro';
import photoMain from '../assets/lessons/lesson-beanbags.jpg';
import photoSecond from '../assets/lessons/lesson-desk.jpg';
import founder from '../assets/team/satyrova.jpg';
import { business, homePath, type Lang } from '../data/business';
import type { Translation } from '../i18n/translations';

interface Props {
  t: Translation;
  lang: Lang;
}
const { t, lang } = Astro.props;
const h = t.hero;
const messenger = lang === 'pl' ? { href: business.messengers.whatsapp, icon: 'whatsapp', label: 'WhatsApp' } : { href: business.messengers.telegram, icon: 'telegram', label: 'Telegram' };
---
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-text">
      <Deco name="sparkle" size={22} class="d-spark1" />
      <p class="eyebrow"><Icon name="pin" size={18} stroke={2} />{h.eyebrow}</p>
      <h1>{h.title}</h1>
      <div class="lead-wrap">
        <Bunny height={104} class="bunny-mobile" eager />
        <p class="hero-lead">{h.lead}</p>
      </div>
      <div class="hero-actions">
        <a href={`${homePath[lang]}#contact`} class="btn btn-primary btn-lg">{t.cta.trial}</a>
        <a href={messenger.href} class="btn btn-secondary btn-lg" target="_blank" rel="noopener">
          <Icon name={messenger.icon} size={20} stroke={2} />{messenger.label}
        </a>
      </div>
      <dl class="hero-stats">
        {h.stats.map((s) => (
          <div>
            <dt data-count={/^\d/.test(s.value) ? s.value : undefined}>{s.value}</dt>
            <dd>{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero-media">
      <Deco name="squiggle" size={420} class="d-squiggle" />
      <Deco name="flower" size={64} class="d-flower1" />
      <Deco name="flower" size={44} tone="lilac" class="d-flower2" />
      <Deco name="heart" size={22} class="d-heart" />
      <div class="photo-main zoom-frame">
        <Zoomable src={photoMain} alt={h.photoMain} label={t.a11y.openPhoto}>
          <Picture src={photoMain} alt={h.photoMain} widths={[360, 540, 720]} sizes="(min-width: 960px) 360px, 92vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
        </Zoomable>
        <span class="free-badge"><Icon name="heart" size={16} filled stroke={1.5} />{h.freeBadge}</span>
      </div>
      <div class="photo-second zoom-frame">
        <Zoomable src={photoSecond} alt={h.photoSecond} label={t.a11y.openPhoto}>
          <Picture src={photoSecond} alt={h.photoSecond} widths={[260, 520]} sizes="260px" formats={['avif', 'webp']} />
        </Zoomable>
      </div>
      <div class="founder-card">
        <Bunny height={120} class="bunny-desktop" delay={1.5} />
        <Zoomable src={founder} alt={h.founderName} label={t.a11y.openPhoto} class="founder-zoom">
          <Image src={founder} alt="" width={96} height={96} class="founder-photo" />
        </Zoomable>
        <div>
          <p class="founder-name">{h.founderName}</p>
          <p class="founder-role">{h.founderRole}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Цифры на первом экране «набегают» от нуля. В HTML остаётся настоящее значение — для поисковиков и без JS.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const raw = el.dataset.count || '';
      const target = parseInt(raw, 10);
      const suffix = raw.replace(/^\d+/, '');
      const t0 = performance.now();
      const dur = 1400;
      const tick = (now: number) => {
        const k = Math.min(1, (now - t0) / dur);
        const eased = 1 - Math.pow(1 - k, 3);
        el.textContent = Math.round(target * eased) + suffix;
        if (k < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-block: 24px 48px;
  }
  /* Мягкое цветное сияние за первым экраном */
  .hero::before {
    content: '';
    position: absolute;
    inset: -80px 0 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(42% 38% at 88% 18%, rgba(243, 182, 234, 0.5), transparent 70%),
      radial-gradient(38% 42% at 6% 8%, rgba(207, 201, 255, 0.6), transparent 70%),
      radial-gradient(46% 40% at 62% 96%, rgba(200, 211, 248, 0.55), transparent 72%);
  }
  .hero-text {
    position: relative;
  }
  .hero-text :global(.d-spark1) {
    top: -6px;
    right: 8%;
  }
  .hero-media :global(.d-squiggle) {
    display: none;
  }
  .hero-media :global(.d-flower1) {
    top: -22px;
    right: -10px;
    z-index: 3;
  }
  .hero-media :global(.d-flower2),
  .hero-media :global(.d-heart) {
    display: none;
  }
  .hero-grid {
    display: grid;
    gap: 28px;
  }
  .hero-text {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .hero-lead {
    font-size: 17px;
    color: var(--c-ink-2);
    max-width: 560px;
  }
  .hero-actions {
    display: none;
  }
  .hero-stats {
    display: grid;
    /* сколько показателей — столько равных колонок */
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 8px;
    margin: 0;
    order: 3;
  }
  .hero-stats div {
    background: var(--c-surface);
    border-radius: var(--r-m);
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .hero-stats dt {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 14px;
    white-space: nowrap;
    line-height: 1.2;
  }
  .hero-stats dd {
    margin: 0;
    font-size: 13px;
    line-height: 1.35;
    color: var(--c-muted);
  }

  .hero-media {
    position: relative;
  }
  .photo-main {
    position: relative;
    border-radius: var(--r-l);
    overflow: hidden;
    background: var(--c-lavender);
    aspect-ratio: 4 / 3.3;
  }
  .photo-main :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .free-badge {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--c-surface);
    color: var(--c-ink);
    border-radius: 14px;
    padding: 8px 12px;
    font-size: 14px;
    font-weight: 700;
    box-shadow: 0 6px 20px rgba(35, 30, 69, 0.15);
  }
  .free-badge :global(svg) {
    color: var(--c-heart);
  }
  .lead-wrap::after {
    content: '';
    display: block;
    clear: both;
  }
  :global(.bunny-mobile) {
    float: right;
    margin: -6px 0 0 10px;
    shape-outside: margin-box;
  }
  .photo-second,
  .founder-card {
    display: none;
  }

  @media (min-width: 960px) {
    .hero {
      padding-block: 56px 72px;
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: 56px;
      align-items: center;
    }
    .hero-text {
      gap: 24px;
    }
    .hero-lead {
      font-size: 19px;
    }
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    .hero-stats {
      display: flex;
      gap: 32px;
      padding-top: 8px;
    }
    .hero-stats div {
      background: none;
      padding: 0;
    }
    .hero-stats dt {
      font-size: 26px;
    }
    .hero-stats dd {
      font-size: 14px;
    }
    .hero-media {
      height: 560px;
    }
    .hero-media :global(.d-squiggle) {
      display: block;
      left: -60px;
      bottom: 40px;
      opacity: 0.9;
    }
    .hero-media :global(.d-flower1) {
      top: -26px;
      left: 300px;
      right: auto;
    }
    .hero-media :global(.d-flower2) {
      display: block;
      right: -22px;
      top: 330px;
      z-index: 3;
    }
    .hero-media :global(.d-heart) {
      display: block;
      left: -24px;
      top: 120px;
    }
    .hero-text :global(.d-spark1) {
      top: -18px;
      right: 18%;
    }
    .photo-main {
      position: absolute;
      left: 0;
      top: 0;
      width: 340px;
      height: 470px;
      aspect-ratio: auto;
      border-radius: var(--r-xl);
    }
    :global(.bunny-mobile) {
      display: none !important;
    }
    .photo-second {
      display: block;
      position: absolute;
      right: 0;
      top: 56px;
      width: 236px;
      height: 300px;
      border-radius: var(--r-xl);
      overflow: hidden;
      --ring: 0 0 0 8px var(--c-bg);
      box-shadow: var(--ring);
    }
    .photo-second :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .founder-card {
      position: absolute;
      right: 16px;
      bottom: 16px;
      width: 320px;
      display: flex;
      align-items: center;
      gap: 14px;
      background: var(--c-surface);
      border-radius: 20px;
      padding: 14px 16px;
      box-shadow: var(--shadow-float);
    }
    :global(.founder-zoom) {
      width: 52px !important;
      height: 52px !important;
      border-radius: 50%;
      flex: none;
    }
    .founder-photo {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      object-fit: cover;
      object-position: center 15%;
      flex: none;
    }
    .founder-name {
      font-weight: 700;
      font-size: 15px;
      line-height: 1.3;
    }
    .founder-role {
      font-size: 13px;
      line-height: 1.35;
      color: var(--c-muted);
    }
    /* Зайчик стоит на карточке основательницы, не перекрывая фото людей */
    :global(.bunny-desktop) {
      position: absolute !important;
      right: 14px;
      bottom: calc(100% - 14px);
    }
  }
  @media (max-width: 959px) {
    :global(.bunny-desktop) {
      display: none !important;
    }
  }
</style>
