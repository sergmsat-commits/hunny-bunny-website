---
import CoursePage from '../../components/CoursePage.astro';
import { courseIds, coursePath, ruOnlyCourseIds } from '../../data/courses';

export function getStaticPaths() {
  return [...courseIds, ...ruOnlyCourseIds].map((id) => ({
    params: { slug: coursePath[id].ru!.split('/').filter(Boolean).pop() },
    props: { id },
  }));
}
const { id } = Astro.props;
---
<CoursePage lang="ru" id={id} />
