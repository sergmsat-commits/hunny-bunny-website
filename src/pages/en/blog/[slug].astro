---
import BlogPost from '../../../components/BlogPost.astro';
import { postIds, postPath } from '../../../data/blog';

export function getStaticPaths() {
  return postIds
    .filter((id) => postPath[id].en)
    .map((id) => ({ params: { slug: postPath[id].en!.split('/').filter(Boolean).pop() }, props: { id } }));
}
const { id } = Astro.props;
---
<BlogPost lang="en" id={id} />
